<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole UI; this platform theme only avoids a light flash before first frame. -->
    <style name="Theme.AgentPulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pulse_background</item>
        <item name="android:statusBarColor">@color/pulse_background</item>
        <item name="android:navigationBarColor">@color/pulse_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
